{
  "name": "orion",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env VITE_API_URL=http://localhost:5000/api vite",
    "build": "node scripts/generate-sitemap.js && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "sitemap": "node scripts/generate-sitemap.js",
    "postbuild": "node scripts/run-snap.js",
    "release": "standard-version -m \"chore(release): v%s [skip ci]\"",
    "test:journal": "node tests/journal/run.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node tests/journal/run.mjs && node --test tests/dataUrl.test.mjs",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "dompurify": "^3.4.16",
    "echarts": "^6.0.0",
    "firebase": "^10.8.0",
    "katex": "^0.18.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.0",
    "react-phone-input-2": "^2.15.1",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "react-to-print": "^3.2.0",
    "recharts": "^3.5.1",
    "remixicon": "^4.7.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sparticuz/chromium": "^143.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "puppeteer": "^24.34.0",
    "puppeteer-core": "^24.34.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
